# ==============================================================================
# JanSetu AI — Local Development Environment Template (.env.example)
# Copy this file to .env for local offline development.
# ==============================================================================

# Groq Vision Multimodal Model (Optional for local fallback/simulation)
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"

# Service Runtime
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT="8000"
DEMO_MODE=true
MAX_UPLOAD_SIZE_MB=10

# Permitted CORS Origins (Vite React & Streamlit Companion)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8501"

# Database: SQLite for local offline development
DATABASE_URL="sqlite:///./data/jansetu.db"

# Storage: Local filesystem persistence
STORAGE_PROVIDER="local"
STORAGE_DIR="./data/uploads"

# Optional Hosted Storage (Set STORAGE_PROVIDER="supabase" to test remote storage)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="jansetu-evidence"
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=900

