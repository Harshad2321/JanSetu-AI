# ==============================================================================
# JanSetu AI — Production Deployment Environment Template (.env.production.example)
# Configure these variables in Render, Vercel, and Streamlit dashboards.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER (FastAPI Backend Service)
# ------------------------------------------------------------------------------
ENVIRONMENT="production"
HOST="0.0.0.0"
# Note: Render automatically assigns the PORT environment variable.
DEMO_MODE=true
MAX_UPLOAD_SIZE_MB=10

# Groq Multimodal Vision Model (Backend Server-Side ONLY)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"

# Supabase PostgreSQL Database (Use Transaction Pooler on port 6543)
# Format: postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.yourprojectref:your_database_password@aws-0-region.pooler.supabase.com:6543/postgres"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Supabase Storage (Private Evidence Bucket)
STORAGE_PROVIDER="supabase"
SUPABASE_URL="https://yourprojectref.supabase.co"
# Service-Role key has admin access to bypass RLS for private storage.
# NEVER expose this key in React or Streamlit frontend code!
SUPABASE_SERVICE_ROLE_KEY="eyJh...your_supabase_service_role_secret..."
SUPABASE_STORAGE_BUCKET="jansetu-evidence"
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=900

# Allowed CORS Origins (Vercel Frontend & Streamlit Community Cloud)
# Format: comma-separated origins without trailing slashes
CORS_ALLOWED_ORIGINS="https://your-jansetu-app.vercel.app,https://your-jansetu-companion.streamlit.app"

# ------------------------------------------------------------------------------
# 2. VERCEL (React + Vite Frontend)
# ------------------------------------------------------------------------------
# Public API base URL pointing to hosted Render backend service
VITE_API_BASE_URL="https://jansetu-ai-api.onrender.com"

# ------------------------------------------------------------------------------
# 3. STREAMLIT COMMUNITY CLOUD (Companion Dashboard)
# In Streamlit Cloud: App Settings -> Secrets (TOML format)
# ------------------------------------------------------------------------------
# FASTAPI_BASE_URL = "https://jansetu-ai-api.onrender.com"
# API_TIMEOUT_SECONDS = 30.0
